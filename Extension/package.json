{
  "name": "pass-extension",
  "version": "0.1.3",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Passyble browser extension (Manifest V3) for Chrome, Edge and Firefox",
  "type": "module",
  "scripts": {
    "test": "node --test --import ./test/helpers/i18n-setup.js --import ./test/helpers/wasm-hooks.js test/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.e2e.mjs",
    "check": "node scripts/check-syntax.mjs",
    "check:emdash": "node scripts/check-no-emdash.mjs",
    "firefox-manifest": "node scripts/make-firefox-manifest.mjs",
    "icons": "node scripts/make-icons.mjs",
    "package": "node scripts/package.mjs",
    "package:opera": "node scripts/package-opera.mjs",
    "release": "node scripts/build-wasm.mjs && node scripts/package.mjs",
    "wasm": "node scripts/build-wasm.mjs"
  },
  "devDependencies": {
    "jsdom": "^25.0.1"
  }
}
